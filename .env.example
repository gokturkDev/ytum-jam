LLM_BACKEND=fake
OPENAI_API_KEY=
# Explicit model supporting Responses Structured Outputs, e.g. gpt-4o-mini.
OPENAI_MODEL=
# Leave empty for the bundled, temporary personas.
PERSONAS_FILE=
OBJECTIONS_MIN=1
OBJECTIONS_MAX=1
# Optional overrides for all reforms; normally leave these unset.
# STARTING_SUPPORT=30
# TARGET_SUPPORT=60
# MAX_ROUNDS=3
PROVIDER_CONCURRENCY=3
PROVIDER_TIMEOUT_SECONDS=30
TURN_TIMEOUT_SECONDS=75
GENERATION_TIMEOUT_SECONDS=75
MAX_OUTPUT_TOKENS=1200
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CLIENT_BASE_URL=http://127.0.0.1:8000
CLIENT_TIMEOUT_SECONDS=90
# Optional local public-game transcripts; contains player answers.
TRANSCRIPT_DIR=
